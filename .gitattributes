# commun:debut v6
# LF in the repository and in the working tree: Git's LF to CRLF conversion changed bytes and broke hash comparisons.
* text=auto eol=lf

# Windows shells need CRLF; PowerShell reads LF scripts fine.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=lf
*.sh text eol=lf

