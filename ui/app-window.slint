import {
    AboutSlint,
    Button,
    CheckBox,
    ComboBox,
    GroupBox,
    LineEdit,
    ScrollView,
    StandardTableView,
    ListView,
    ProgressIndicator,
    TabWidget,
    VerticalBox,
    HorizontalBox,
    GridBox,
} from "std-widgets.slint";
import { Theme, Heading } from "theme.slint";

// Texts of the Data tab, computed in Rust from the database (src/ui_bridge.rs).
export struct DataStatus {
    database-path: string,
    has-run: bool,
    started-at: string,
    finished-at: string,
    status: string,
    source: string,
    revision: string,
    message: string,
    nodes: string,
    items: string,
    drops: string,
}

component Field inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    spacing: 8px;
    Text {
        text: root.label;
        min-width: 140px;
        horizontal-stretch: 0;
        color: Theme.accent;
    }

    Text {
        text: root.value;
        wrap: word-wrap;
        horizontal-stretch: 1;
    }
}

component DataTab inherits VerticalBox {
    in property <DataStatus> status;
    in property <bool> busy;
    in property <float> progress;
    in property <[string]> log-lines;
    callback update-from-wiki();
    callback reimport-from-cache();

    GroupBox {
        title: "Base";
        VerticalLayout {
            spacing: 4px;
            Field {
                label: "Fichier";
                value: root.status.database-path;
            }

            Field {
                label: "Nœuds";
                value: root.status.nodes;
            }

            Field {
                label: "Objets";
                value: root.status.items;
            }

            Field {
                label: "Drops";
                value: root.status.drops;
            }
        }
    }

    GroupBox {
        title: "Dernier import";
        VerticalLayout {
            spacing: 4px;
            if !root.status.has-run: Text {
                text: "Aucun import : lancez une mise à jour.";
            }
            if root.status.has-run: VerticalLayout {
                spacing: 4px;
                Field {
                    label: "Statut";
                    value: root.status.status;
                }

                Field {
                    label: "Début";
                    value: root.status.started-at;
                }

                Field {
                    label: "Fin";
                    value: root.status.finished-at;
                }

                Field {
                    label: "Source";
                    value: root.status.source;
                }

                Field {
                    label: "Révision";
                    value: root.status.revision;
                }

                Field {
                    label: "Message";
                    value: root.status.message;
                }
            }
        }
    }

    HorizontalBox {
        padding: 0px;
        Button {
            accessible-id: "update-from-wiki";
            text: "Mettre à jour depuis le wiki";
            enabled: !root.busy;
            clicked => {
                root.update-from-wiki();
            }
        }

        Button {
            accessible-id: "reimport-from-cache";
            text: "Réimporter depuis le cache";
            enabled: !root.busy;
            clicked => {
                root.reimport-from-cache();
            }
        }

        Rectangle {
            horizontal-stretch: 1;
        }
    }

    ProgressIndicator {
        progress: root.progress;
        height: 8px;
    }

    GroupBox {
        title: "Journal";
        vertical-stretch: 1;
        log-view := ListView {
            accessible-id: "import-log";
            for line in root.log-lines: Text {
                text: line;
                wrap: word-wrap;
            }
        }
    }

    // Keep the newest line visible as the log grows.
    changed log-lines => {
        log-view.content-y = min(0px, log-view.visible-height - log-view.content-height);
    }
}

// Removable chip of a chosen item.
component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> enabled;
    callback remove();
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.accent;
    background: Theme.hover;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 2px;
        spacing: 4px;
        alignment: start;
        Text {
            text: root.text;
            vertical-alignment: center;
        }

        Button {
            accessible-id: "remove-item";
            accessible-label: "Retirer " + root.text;
            text: "✕";
            enabled: root.enabled;
            clicked => {
                root.remove();
            }
        }
    }
}

// Search tab: state and queries live in Rust (src/ui_bridge.rs, src/search_view.rs).
component SearchTab inherits VerticalBox {
    in property <bool> has-data;
    in property <bool> enabled;
    in property <[string]> mission-types;
    in-out property <int> mission-type-index;
    in-out property <int> mode-index;
    in-out property <int> specials-index;
    in-out property <int> dark-sectors-index;
    in-out property <bool> rotation-a;
    in-out property <bool> rotation-b;
    in-out property <bool> rotation-c;
    in property <[string]> categories;
    in-out property <int> category-index;
    in-out property <string> query;
    in property <[string]> suggestions;
    in property <[string]> selected-items;
    in property <string> summary;
    in property <[TableColumn]> columns;
    in property <[[StandardListViewItem]]> rows;
    callback query-edited(string);
    callback category-changed();
    callback add-suggestion(int);
    callback remove-item(int);
    callback filters-changed();
    callback sort-ascending(int);
    callback sort-descending(int);

    if !root.has-data: Text {
        text: "Lancez un import depuis l'onglet Données.";
        horizontal-alignment: center;
        vertical-alignment: center;
        vertical-stretch: 1;
    }
    if root.has-data: VerticalLayout {
        spacing: 8px;
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: "Type de mission";
                vertical-alignment: center;
            }

            ComboBox {
                accessible-id: "mission-type";
                model: root.mission-types;
                current-index <=> root.mission-type-index;
                enabled: root.enabled;
                horizontal-stretch: 2;
                selected => {
                    root.filters-changed();
                }
            }

            Text {
                text: "Mode";
                vertical-alignment: center;
            }

            ComboBox {
                accessible-id: "search-mode";
                model: ["Par objet", "Combiné"];
                current-index <=> root.mode-index;
                enabled: root.enabled;
                horizontal-stretch: 1;
                selected => {
                    root.filters-changed();
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: "Rotations";
                vertical-alignment: center;
            }

            CheckBox {
                accessible-id: "rotation-a";
                text: "A";
                checked <=> root.rotation-a;
                enabled: root.enabled;
                toggled => {
                    root.filters-changed();
                }
            }

            CheckBox {
                accessible-id: "rotation-b";
                text: "B";
                checked <=> root.rotation-b;
                enabled: root.enabled;
                toggled => {
                    root.filters-changed();
                }
            }

            CheckBox {
                accessible-id: "rotation-c";
                text: "C";
                checked <=> root.rotation-c;
                enabled: root.enabled;
                toggled => {
                    root.filters-changed();
                }
            }

            Rectangle {
                width: 16px;
            }

            Text {
                text: "Missions spéciales";
                vertical-alignment: center;
            }

            ComboBox {
                accessible-id: "special-missions";
                model: ["Incluses", "Exclues", "Uniquement"];
                current-index <=> root.specials-index;
                enabled: root.enabled;
                selected => {
                    root.filters-changed();
                }
            }

            Text {
                text: "Secteurs sombres";
                vertical-alignment: center;
            }

            ComboBox {
                accessible-id: "dark-sectors";
                model: ["Inclus", "Exclus", "Uniquement"];
                current-index <=> root.dark-sectors-index;
                enabled: root.enabled;
                selected => {
                    root.filters-changed();
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: "Objets";
                vertical-alignment: center;
            }

            ComboBox {
                accessible-id: "item-category";
                model: root.categories;
                current-index <=> root.category-index;
                enabled: root.enabled;
                min-width: 180px;
                horizontal-stretch: 0;
                selected => {
                    root.category-changed();
                }
            }

            LineEdit {
                accessible-id: "item-query";
                placeholder-text: "Ajouter un objet (nom ou partie du nom)…";
                text <=> root.query;
                enabled: root.enabled;
                edited(text) => {
                    root.query-edited(text);
                }
                accepted => {
                    root.add-suggestion(0);
                }
            }
        }

        if root.suggestions.length > 0: Rectangle {
            border-width: 1px;
            border-color: Theme.border;
            background: Theme.panel;
            height: min(root.suggestions.length, 8) * 28px + 4px;
            ListView {
                accessible-id: "item-suggestions";
                for suggestion[index] in root.suggestions: Rectangle {
                    height: 28px;
                    background: suggestion-touch.has-hover ? Theme.hover : transparent;
                    suggestion-touch := TouchArea {
                        accessible-role: button;
                        accessible-label: suggestion;
                        enabled: root.enabled;
                        clicked => {
                            root.add-suggestion(index);
                        }
                    }

                    Text {
                        x: 8px;
                        text: suggestion;
                        vertical-alignment: center;
                    }
                }
            }
        }

        if root.selected-items.length > 0: ScrollView {
            height: 44px;
            HorizontalLayout {
                spacing: 6px;
                padding: 4px;
                alignment: start;
                for item[index] in root.selected-items: Chip {
                    text: item;
                    enabled: root.enabled;
                    remove => {
                        root.remove-item(index);
                    }
                }
            }
        }

        Text {
            text: root.summary;
            color: Theme.muted;
        }

        StandardTableView {
            accessible-id: "search-results";
            vertical-stretch: 1;
            columns: root.columns;
            rows: root.rows;
            sort-ascending(column) => {
                root.sort-ascending(column);
            }
            sort-descending(column) => {
                root.sort-descending(column);
            }
        }
    }
}

// Spot Search tab: enemies dropping the chosen items, then the nodes where they appear.
// State and queries live in Rust (src/ui_bridge/spot.rs, src/spot_view.rs).
component SpotTab inherits VerticalBox {
    in property <bool> has-data;
    in property <bool> enabled;
    in property <[string]> mission-types;
    in-out property <int> mission-type-index;
    in property <[string]> planets;
    in-out property <int> planet-index;
    in property <[string]> categories;
    in-out property <int> category-index;
    in-out property <string> query;
    in property <[string]> suggestions;
    in property <[string]> selected-items;
    in property <string> summary;
    in property <[TableColumn]> enemy-columns;
    in property <[[StandardListViewItem]]> enemy-rows;
    in-out property <int> enemy-current-row;
    in property <bool> enemy-picked;
    in property <string> nodes-title;
    in property <[TableColumn]> node-columns;
    in property <[[StandardListViewItem]]> node-rows;
    callback query-edited(string);
    callback category-changed();
    callback add-suggestion(int);
    callback remove-item(int);
    callback filters-changed();
    callback enemy-selected(int);
    callback clear-enemy();
    callback enemy-sort-ascending(int);
    callback enemy-sort-descending(int);
    callback node-sort-ascending(int);
    callback node-sort-descending(int);

    if !root.has-data: Text {
        text: "Lancez un import depuis l'onglet Données.";
        horizontal-alignment: center;
        vertical-alignment: center;
        vertical-stretch: 1;
    }
    if root.has-data: VerticalLayout {
        spacing: 8px;
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: "Type de mission";
                vertical-alignment: center;
            }

            ComboBox {
                accessible-id: "spot-mission-type";
                model: root.mission-types;
                current-index <=> root.mission-type-index;
                enabled: root.enabled;
                horizontal-stretch: 2;
                selected => {
                    root.filters-changed();
                }
            }

            Text {
                text: "Planète";
                vertical-alignment: center;
            }

            ComboBox {
                accessible-id: "spot-planet";
                model: root.planets;
                current-index <=> root.planet-index;
                enabled: root.enabled;
                horizontal-stretch: 1;
                selected => {
                    root.filters-changed();
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: "Objets";
                vertical-alignment: center;
            }

            ComboBox {
                accessible-id: "spot-item-category";
                model: root.categories;
                current-index <=> root.category-index;
                enabled: root.enabled;
                min-width: 180px;
                horizontal-stretch: 0;
                selected => {
                    root.category-changed();
                }
            }

            LineEdit {
                accessible-id: "spot-item-query";
                placeholder-text: "Ajouter un objet (nom ou partie du nom)…";
                text <=> root.query;
                enabled: root.enabled;
                edited(text) => {
                    root.query-edited(text);
                }
                accepted => {
                    root.add-suggestion(0);
                }
            }
        }

        if root.suggestions.length > 0: Rectangle {
            border-width: 1px;
            border-color: Theme.border;
            background: Theme.panel;
            height: min(root.suggestions.length, 8) * 28px + 4px;
            ListView {
                accessible-id: "spot-item-suggestions";
                for suggestion[index] in root.suggestions: Rectangle {
                    height: 28px;
                    background: spot-suggestion-touch.has-hover ? Theme.hover : transparent;
                    spot-suggestion-touch := TouchArea {
                        accessible-role: button;
                        accessible-label: suggestion;
                        enabled: root.enabled;
                        clicked => {
                            root.add-suggestion(index);
                        }
                    }

                    Text {
                        x: 8px;
                        text: suggestion;
                        vertical-alignment: center;
                    }
                }
            }
        }

        if root.selected-items.length > 0: ScrollView {
            height: 44px;
            HorizontalLayout {
                spacing: 6px;
                padding: 4px;
                alignment: start;
                for item[index] in root.selected-items: Chip {
                    text: item;
                    enabled: root.enabled;
                    remove => {
                        root.remove-item(index);
                    }
                }
            }
        }

        Text {
            text: root.summary;
            color: Theme.muted;
        }

        Heading {
            text: "Ennemis au meilleur taux (cliquer une ligne pour voir ses nœuds)";
        }

        StandardTableView {
            accessible-id: "spot-enemies";
            vertical-stretch: 1;
            columns: root.enemy-columns;
            rows: root.enemy-rows;
            current-row <=> root.enemy-current-row;
            current-row-changed(row) => {
                root.enemy-selected(row);
            }
            sort-ascending(column) => {
                root.enemy-sort-ascending(column);
            }
            sort-descending(column) => {
                root.enemy-sort-descending(column);
            }
        }

        HorizontalLayout {
            spacing: 8px;
            Heading {
                text: root.nodes-title;
                vertical-alignment: center;
            }

            Button {
                accessible-id: "spot-all-enemies";
                text: "Tous les ennemis";
                enabled: root.enabled && root.enemy-picked;
                clicked => {
                    root.clear-enemy();
                }
            }

            Rectangle {
                horizontal-stretch: 1;
            }
        }

        StandardTableView {
            accessible-id: "spot-nodes";
            vertical-stretch: 1;
            columns: root.node-columns;
            rows: root.node-rows;
            sort-ascending(column) => {
                root.node-sort-ascending(column);
            }
            sort-descending(column) => {
                root.node-sort-descending(column);
            }
        }
    }
}

// Relics tab: relics giving the parts of the chosen Warframe, from the DE drop tables.
// State and queries live in Rust (src/ui_bridge/relics.rs, src/relic_view.rs).
component RelicTab inherits VerticalBox {
    in property <bool> has-data;
    in property <bool> enabled;
    in-out property <string> query;
    in property <[string]> suggestions;
    // Chosen Warframe, empty when none.
    in property <string> selected;
    in property <[string]> flag-choices;
    in-out property <int> mission-index;
    in-out property <int> vaulted-index;
    in property <string> summary;
    in property <[TableColumn]> columns;
    in property <[[StandardListViewItem]]> rows;
    callback query-edited(string);
    callback add-suggestion(int);
    callback clear-warframe();
    callback filters-changed();
    callback sort-ascending(int);
    callback sort-descending(int);

    if !root.has-data: Text {
        text: "Aucune relique en base : lancez une mise à jour depuis l'onglet Données.";
        horizontal-alignment: center;
        vertical-alignment: center;
        vertical-stretch: 1;
    }
    if root.has-data: VerticalLayout {
        spacing: 8px;
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: "Warframe";
                vertical-alignment: center;
            }

            LineEdit {
                accessible-id: "relic-warframe-query";
                placeholder-text: "Choisir une Warframe (nom ou partie du nom)…";
                text <=> root.query;
                enabled: root.enabled;
                edited(text) => {
                    root.query-edited(text);
                }
                accepted => {
                    root.add-suggestion(0);
                }
            }

            Text {
                text: "En mission";
                vertical-alignment: center;
            }

            ComboBox {
                accessible-id: "relic-mission-filter";
                model: root.flag-choices;
                current-index <=> root.mission-index;
                enabled: root.enabled;
                horizontal-stretch: 0;
                selected => {
                    root.filters-changed();
                }
            }

            Text {
                text: "Vaulted";
                vertical-alignment: center;
            }

            ComboBox {
                accessible-id: "relic-vaulted-filter";
                model: root.flag-choices;
                current-index <=> root.vaulted-index;
                enabled: root.enabled;
                horizontal-stretch: 0;
                selected => {
                    root.filters-changed();
                }
            }
        }

        if root.suggestions.length > 0: Rectangle {
            border-width: 1px;
            border-color: Theme.border;
            background: Theme.panel;
            height: min(root.suggestions.length, 8) * 28px + 4px;
            ListView {
                accessible-id: "relic-warframe-suggestions";
                for suggestion[index] in root.suggestions: Rectangle {
                    height: 28px;
                    background: relic-suggestion-touch.has-hover ? Theme.hover : transparent;
                    relic-suggestion-touch := TouchArea {
                        accessible-role: button;
                        accessible-label: suggestion;
                        enabled: root.enabled;
                        clicked => {
                            root.add-suggestion(index);
                        }
                    }

                    Text {
                        x: 8px;
                        text: suggestion;
                        vertical-alignment: center;
                    }
                }
            }
        }

        if root.selected != "": HorizontalLayout {
            padding: 4px;
            alignment: start;
            Chip {
                text: root.selected;
                enabled: root.enabled;
                remove => {
                    root.clear-warframe();
                }
            }
        }

        Text {
            text: root.summary;
            color: Theme.muted;
        }

        StandardTableView {
            accessible-id: "relic-rewards";
            vertical-stretch: 1;
            columns: root.columns;
            rows: root.rows;
            sort-ascending(column) => {
                root.sort-ascending(column);
            }
            sort-descending(column) => {
                root.sort-descending(column);
            }
        }
    }
}

component AboutTab inherits VerticalBox {
    in property <string> version;
    alignment: start;

    Heading {
        text: "Plop-Warframe " + root.version;
        font-size: 22px;
    }

    GroupBox {
        title: "Données";
        VerticalBox {
            Text {
                accessible-id: "about-data-attribution";
                wrap: word-wrap;
                text: "Les tables de drop proviennent du wiki Warframe (wiki.warframe.com), écrit par ses contributeurs et publié sous licence CC BY-NC-SA 3.0 (creativecommons.org/licenses/by-nc-sa/3.0). Le contenu des reliques provient des tables de drop officielles publiées par Digital Extremes (warframe.com/droptables), et leur statut vaulted du paquet @wfcd/items (WFCD, licence MIT). L'application lit ces données et les réorganise sans les modifier ; elle n'est ni affiliée ni approuvée par Digital Extremes ou par le wiki.";
            }
        }
    }

    GroupBox {
        title: "Logiciels tiers";
        VerticalBox {
            Text {
                wrap: word-wrap;
                text: "Les licences des bibliothèques embarquées (Rust, SQLite, Lua, Slint) sont listées dans NOTICES.md, livré avec l'application.";
            }

            AboutSlint {
                max-height: 200px;
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Plop-Warframe";
    icon: @image-url("icons/coffre.svg");
    default-font-family: Theme.body-font;
    background: Theme.content;
    in property <string> version;
    preferred-width: 1100px;
    preferred-height: 750px;

    in property <DataStatus> data-status;
    in property <bool> busy;
    in property <float> progress;
    in property <[string]> log-lines;
    callback update-from-wiki();
    callback reimport-from-cache();
    // Raised by Rust once an import has ended, to reload the search tabs.
    callback import-finished();

    in property <bool> search-has-data;
    in property <[string]> search-mission-types;
    in-out property <int> search-mission-type-index;
    in-out property <int> search-mode-index;
    in-out property <int> search-specials-index;
    in-out property <int> search-dark-sectors-index;
    in-out property <bool> search-rotation-a: true;
    in-out property <bool> search-rotation-b: true;
    in-out property <bool> search-rotation-c: true;
    in property <[string]> search-categories;
    in-out property <int> search-category-index;
    in-out property <string> search-query;
    in property <[string]> search-suggestions;
    in property <[string]> search-selected-items;
    in property <string> search-summary;
    in property <[TableColumn]> search-columns;
    in property <[[StandardListViewItem]]> search-rows;
    callback search-query-edited(string);
    callback search-category-changed();
    callback search-add-suggestion(int);
    callback search-remove-item(int);
    callback search-filters-changed();
    callback search-sort-ascending(int);
    callback search-sort-descending(int);

    in property <bool> spot-has-data;
    in property <[string]> spot-mission-types;
    in-out property <int> spot-mission-type-index;
    in property <[string]> spot-planets;
    in-out property <int> spot-planet-index;
    in property <[string]> spot-categories;
    in-out property <int> spot-category-index;
    in-out property <string> spot-query;
    in property <[string]> spot-suggestions;
    in property <[string]> spot-selected-items;
    in property <string> spot-summary;
    in property <[TableColumn]> spot-enemy-columns;
    in property <[[StandardListViewItem]]> spot-enemy-rows;
    in-out property <int> spot-enemy-current-row: -1;
    in property <bool> spot-enemy-picked;
    in property <string> spot-nodes-title;
    in property <[TableColumn]> spot-node-columns;
    in property <[[StandardListViewItem]]> spot-node-rows;
    callback spot-query-edited(string);
    callback spot-category-changed();
    callback spot-add-suggestion(int);
    callback spot-remove-item(int);
    callback spot-filters-changed();
    callback spot-enemy-selected(int);
    callback spot-clear-enemy();
    callback spot-enemy-sort-ascending(int);
    callback spot-enemy-sort-descending(int);
    callback spot-node-sort-ascending(int);
    callback spot-node-sort-descending(int);

    in property <bool> relic-has-data;
    in-out property <string> relic-query;
    in property <[string]> relic-suggestions;
    in property <string> relic-selected;
    in property <[string]> relic-flag-choices;
    in-out property <int> relic-mission-index;
    in-out property <int> relic-vaulted-index;
    in property <string> relic-summary;
    in property <[TableColumn]> relic-columns;
    in property <[[StandardListViewItem]]> relic-rows;
    callback relic-query-edited(string);
    callback relic-add-suggestion(int);
    callback relic-clear-warframe();
    callback relic-filters-changed();
    callback relic-sort-ascending(int);
    callback relic-sort-descending(int);

    VerticalLayout {
    // Header bar, as the wiki's dark top band.
    Rectangle {
            height: 44px;
            background: Theme.page;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                Heading {
                    text: "PLOP-WARFRAME";
                    font-size: 20px;
                    letter-spacing: 2px;
                    vertical-alignment: center;
                }

                Text {
                    text: "Meilleurs lieux de drop";
                    color: Theme.muted;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                y: parent.height - 2px;
                height: 2px;
                background: Theme.accent;
            }
        }

        TabWidget {
            Tab {
                title: "Données";
                DataTab {
                    status: root.data-status;
                    busy: root.busy;
                    progress: root.progress;
                    log-lines: root.log-lines;
                    update-from-wiki => {
                        root.update-from-wiki();
                    }
                    reimport-from-cache => {
                        root.reimport-from-cache();
                    }
                }
            }

            Tab {
                title: "Recherche Mission";
                SearchTab {
                    has-data: root.search-has-data;
                    enabled: !root.busy;
                    mission-types: root.search-mission-types;
                    mission-type-index <=> root.search-mission-type-index;
                    mode-index <=> root.search-mode-index;
                    specials-index <=> root.search-specials-index;
                    dark-sectors-index <=> root.search-dark-sectors-index;
                    rotation-a <=> root.search-rotation-a;
                    rotation-b <=> root.search-rotation-b;
                    rotation-c <=> root.search-rotation-c;
                    categories: root.search-categories;
                    category-index <=> root.search-category-index;
                    query <=> root.search-query;
                    suggestions: root.search-suggestions;
                    selected-items: root.search-selected-items;
                    summary: root.search-summary;
                    columns: root.search-columns;
                    rows: root.search-rows;
                    query-edited(text) => {
                        root.search-query-edited(text);
                    }
                    category-changed => {
                        root.search-category-changed();
                    }
                    add-suggestion(index) => {
                        root.search-add-suggestion(index);
                    }
                    remove-item(index) => {
                        root.search-remove-item(index);
                    }
                    filters-changed => {
                        root.search-filters-changed();
                    }
                    sort-ascending(column) => {
                        root.search-sort-ascending(column);
                    }
                    sort-descending(column) => {
                        root.search-sort-descending(column);
                    }
                }
            }

            Tab {
                title: "Recherche Spot";
                SpotTab {
                    has-data: root.spot-has-data;
                    enabled: !root.busy;
                    mission-types: root.spot-mission-types;
                    mission-type-index <=> root.spot-mission-type-index;
                    planets: root.spot-planets;
                    planet-index <=> root.spot-planet-index;
                    categories: root.spot-categories;
                    category-index <=> root.spot-category-index;
                    query <=> root.spot-query;
                    suggestions: root.spot-suggestions;
                    selected-items: root.spot-selected-items;
                    summary: root.spot-summary;
                    enemy-columns: root.spot-enemy-columns;
                    enemy-rows: root.spot-enemy-rows;
                    enemy-current-row <=> root.spot-enemy-current-row;
                    enemy-picked: root.spot-enemy-picked;
                    nodes-title: root.spot-nodes-title;
                    node-columns: root.spot-node-columns;
                    node-rows: root.spot-node-rows;
                    query-edited(text) => {
                        root.spot-query-edited(text);
                    }
                    category-changed => {
                        root.spot-category-changed();
                    }
                    add-suggestion(index) => {
                        root.spot-add-suggestion(index);
                    }
                    remove-item(index) => {
                        root.spot-remove-item(index);
                    }
                    filters-changed => {
                        root.spot-filters-changed();
                    }
                    enemy-selected(row) => {
                        root.spot-enemy-selected(row);
                    }
                    clear-enemy => {
                        root.spot-clear-enemy();
                    }
                    enemy-sort-ascending(column) => {
                        root.spot-enemy-sort-ascending(column);
                    }
                    enemy-sort-descending(column) => {
                        root.spot-enemy-sort-descending(column);
                    }
                    node-sort-ascending(column) => {
                        root.spot-node-sort-ascending(column);
                    }
                    node-sort-descending(column) => {
                        root.spot-node-sort-descending(column);
                    }
                }
            }

            Tab {
                title: "Reliques";
                RelicTab {
                    has-data: root.relic-has-data;
                    enabled: !root.busy;
                    query <=> root.relic-query;
                    suggestions: root.relic-suggestions;
                    selected: root.relic-selected;
                    flag-choices: root.relic-flag-choices;
                    mission-index <=> root.relic-mission-index;
                    vaulted-index <=> root.relic-vaulted-index;
                    summary: root.relic-summary;
                    columns: root.relic-columns;
                    rows: root.relic-rows;
                    query-edited(text) => {
                        root.relic-query-edited(text);
                    }
                    add-suggestion(index) => {
                        root.relic-add-suggestion(index);
                    }
                    clear-warframe => {
                        root.relic-clear-warframe();
                    }
                    filters-changed => {
                        root.relic-filters-changed();
                    }
                    sort-ascending(column) => {
                        root.relic-sort-ascending(column);
                    }
                    sort-descending(column) => {
                        root.relic-sort-descending(column);
                    }
                }
            }

            Tab {
                title: "À propos";
                AboutTab {
                    version: root.version;
                }
            }
        }
    }
}
